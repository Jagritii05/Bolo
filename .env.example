# LocalPill Environment Configuration

# Speech service port (REST baseline mode)
ASR_PORT=7777

# Transport mode: 'graft' (default) or 'rest' (legacy baseline)
TRANSPORT=rest

# Groq Cloud Whisper API Key (Optional)
GROQ_API_KEY=

# Google Gemini API Key (For visual memory & screen assistant)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Audio limits
MAX_AUDIO_SECONDS=600
MAX_AUDIO_MB=50

# MCP Allowed Directory (for Claude Desktop / Antigravity file reading boundary)
# Defaults to %USERPROFILE%\LocalPillRecordings
# MCP_ALLOWED_DIR=C:\Users\username\LocalPillRecordings
