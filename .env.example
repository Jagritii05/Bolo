# ============================================================
# Bolo: Multilingual Screen-Explaining Voice Agent (Gnani AI)
# Environment Configuration
# ============================================================

# 1. Gnani AI Vachana Speech Platform
# Powers Gnani Prisma STT (Speech-to-Text) & Gnani Timbre TTS (Text-to-Speech)
GNANI_API_KEY=

# 2. Google Gemini API Key
# Used for in-memory visual screen text extraction (transcription only, not reasoning)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 3. LLM Reasoning Engine Configuration
# Supported options: 'groq' (recommended) or 'gemini'
LLM_PROVIDER=groq

# Groq Cloud API Key (Recommended: Llama 3.3 70B Versatile)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=

# 4. Default Language
# Options: 'hi-IN' (Hindi/Hinglish), 'ta-IN' (Tamil), 'bn-IN' (Bengali)
DEFAULT_LANGUAGE=hi-IN

# 5. Debug Mode (true for verbose logging to console and logfile)
DEBUG=false
